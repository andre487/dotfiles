#!/usr/bin/env python3
import os
import sys


def main():
    env = os.environ.copy()
    for name in ("all_proxy", "ALL_PROXY", "http_proxy", "HTTP_PROXY", "https_proxy", "HTTPS_PROXY", "no_proxy", "NO_PROXY"):
        env.pop(name, None)
    os.execvpe(sys.argv[1], sys.argv[1:], env=env)


if __name__ == "__main__":
    main()
